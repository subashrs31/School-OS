# App
PORT=8000
NODE_ENV=local

# Database (PostgreSQL). Tests use TEST_DATABASE_URL, which must end in "_test" and differ from DATABASE_URL.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgresql://postgres:password@localhost:5432/school_os"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/school_os_test"

# Auth (secrets must be 16+ chars)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage: local | s3
STORAGE_TYPE=local

# AWS (required if STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=App
MAIL_ENCRYPTION=tls

# Twilio (for SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# OTP_SECRET=your_otp_secret_here
