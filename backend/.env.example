# App
PORT=8000
NODE_ENV=local

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_name_here
DB_USER=root
DB_PASSWORD=

# Auth (secrets must be 16+ chars)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage: local | s3
STORAGE_TYPE=local

# AWS (required if STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=App
MAIL_ENCRYPTION=tls

# OAuth (comma-separated: google,facebook)
# OAUTH_PROVIDERS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Twilio (for SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# OTP_SECRET=your_otp_secret_here
